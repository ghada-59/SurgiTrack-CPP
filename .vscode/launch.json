{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug SurgiTrackApp (Windows, Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/SurgiTrackApp.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Debug SurgiTrackApp (Linux)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/SurgiTrackApp",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb"
        }
    ]
}
